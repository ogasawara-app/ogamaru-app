name: Update Ogasawara Schedule

on:
  schedule:
    - cron: '*/10 * * * *'
  workflow_dispatch:
  pull_request:
    branches: [main]

permissions:
  contents: write

concurrency:
  group: ogamaru-schedule-update-${{ github.ref }}
  cancel-in-progress: false

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install beautifulsoup4

      - uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Run unit tests
        run: |
          python ogamaru_updater.py --test
          python -m unittest -v test_regressions.py
          node test_frontend.cjs
          node --check sw.js

      - name: Fetch latest official schedule
        if: github.ref == 'refs/heads/main' && github.event_name != 'pull_request'
        env:
          LINE_CHANNEL_ACCESS_TOKEN: ${{ secrets.LINE_CHANNEL_ACCESS_TOKEN }}
          WEBHOOK_URL: ${{ secrets.WEBHOOK_URL }}
        run: python ogamaru_updater.py

      - name: Commit and push if changed
        if: github.ref == 'refs/heads/main' && github.event_name != 'pull_request'
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add schedule_data.json schedule_history.csv
          if ! git diff --cached --quiet; then
            git commit -m "chore: update schedule data [skip ci]"
            git pull --rebase
            git push
          fi
